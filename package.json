{
  "name": "pitwall-weather",
  "version": "3.0.0-preview.3",
  "license": "MIT",
  "private": true,
  "description": "Racetrack weather for a race weekend: many forecast sources combined, rain radar and past weather",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1 --port 5173",
    "build": "node scripts/notices.mjs && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "lint": "eslint web/src tests e2e scripts desktop playwright*.config.ts electron-builder.config.cjs eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run typecheck && npm run notices:check && npm run build",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "desktop": "npm run build && install-electron --no && electron .",
    "desktop:prepare": "install-electron --no && node scripts/prepare-desktop.mjs",
    "desktop:mac": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --mac --universal --publish never",
    "desktop:windows": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-Brht/pitwall.git"
  },
  "bugs": {
    "url": "https://github.com/Arthur-Brht/pitwall/issues"
  }
}
